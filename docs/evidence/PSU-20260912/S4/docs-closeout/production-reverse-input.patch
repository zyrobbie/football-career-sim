+ expect(r.eventSummary).not.toContain('承担更高伤病风险')
+ expect(r.eventSummary).not.toContain('抽取')
+})
+it('reports recovery strategy suppression at all ages and retains veteran maintenance explanation', () => {
+ for (const w of [22,44]) {
